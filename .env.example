# ====================
# Pacr Environment Configuration Template
# ====================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# ====================
# Google Gemini API (coach-service — conversational AI coaching)
# ====================
GEMINI_API_KEY=your_gemini_api_key_here

# ====================
# Firebase Cloud Messaging (notification-service)
# ====================
FCM_SERVER_KEY=your_fcm_server_key_here

# ====================
# Email Configuration (Optional)
# ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password_here

# ====================
# Database (Auto-configured by docker-compose)
# ====================
# DATABASE_URL=postgresql://pacr:pacr_dev_password@localhost:5432/pacr_dev

# ====================
# Redis (Auto-configured by docker-compose)
# ====================
# REDIS_URL=redis://:pacr_redis_password@localhost:6379

# ====================
# Kafka (Auto-configured by docker-compose)
# ====================
# KAFKA_BROKERS=localhost:9093

# ====================
# JWT Configuration (Development only)
# ====================
# JWT_SECRET=dev_jwt_secret_change_in_production
# JWT_EXPIRY=15m
# REFRESH_TOKEN_EXPIRY=7d

# ====================
# Application Environment
# ====================
# NODE_ENV=development
# ENVIRONMENT=development
